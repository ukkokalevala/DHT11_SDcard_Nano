#include <SPI.h>
#include <SdFat.h> // Use the SdFat library

SdFat sd; // Create the SdFat object
const int chipSelect = 10;

void setup() {
  Serial.begin(9600);
  while (!Serial);

  Serial.println("Initializing SD card with SdFat...");

  // The begin method is similar, but now it's on your sd object
  if (!sd.begin(chipSelect)) {
    Serial.println("SD Card initialization failed!");
    // SdFat provides detailed error codes for debugging
    Serial.print("Error Code: 0x");
    Serial.println(sd.sdErrorCode(), HEX);
    return;
  }
  Serial.println("SD Card initialized successfully with SdFat.");
}

void loop() {
  // Your logging logic would go here, using the `sd` object instead of `SD`
}
